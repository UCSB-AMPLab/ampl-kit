// Cloudflare Workers configuration (ampl-email)
//
// This file tells Wrangler how to build, deploy, and bind the `ampl-email`
// Worker. It maps the Worker to the `ampl.tools/email` route, declares the
// production D1 database (`EMAIL_DB`) and the per-IP rate limiter, sets the
// quota ceiling vars, and defines a separate `staging` environment that runs
// at its own workers.dev URL against a staging database. Secrets
// (`RESEND_API_KEY`, `RESEND_WEBHOOK_SECRET`, `UNSUB_HMAC_SECRET`) are set per
// environment with `wrangler secret put --config wrangler.email.jsonc`, never
// stored here.
//
// Version: v0.1.0
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ampl-email",
  "compatibility_date": "2026-05-27",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./workers/email.ts",
  // Served at ampl.tools/email (shared AMPL email service). The `send()` RPC
  // method is service-binding-only and needs no route. The public routes
  // (webhook + unsubscribe) are what this route delivers. `workers_dev` is
  // disabled in production so the Worker is reachable only via the route.
  "routes": [
    { "pattern": "ampl.tools/email*", "zone_name": "ampl.tools" }
  ],
  "workers_dev": false,
  // Secrets (per-env via `wrangler secret put --config wrangler.email.jsonc`):
  //   RESEND_API_KEY         — from the Resend dashboard
  //   RESEND_WEBHOOK_SECRET  — whsec_… from Resend webhook endpoint registration
  //   UNSUB_HMAC_SECRET      — 32-byte random key for unsubscribe tokens
  // Quota ceilings are plain vars (non-secret): they are safe to expose and
  // tunable without a deploy.
  "vars": {
    "MONTHLY_QUOTA_CEILING": "2500",
    "DAILY_QUOTA_CEILING": "90"
  },
  // namespace_id 3 (prod) and 4 (staging) — distinct from ampl-auth's 1/2.
  // Never reuse auth's namespace IDs or the rate limiters will cross-pollinate.
  "ratelimits": [
    {
      "name": "EMAIL_RATE_LIMITER",
      "namespace_id": "3",
      "simple": { "limit": 5, "period": 60 }
    }
  ],
  "d1_databases": [
    {
      "binding": "EMAIL_DB",
      "database_name": "ampl-email-db",
      "database_id": "add98748-0830-46ca-aee7-bd841015a613",
      "migrations_dir": "drizzle-email"
    }
  ],
  "env": {
    "staging": {
      "name": "ampl-email-staging",
      // No ampl.tools route on staging; lives only at its workers.dev URL.
      // routes:[] is explicit to prevent config merging surprises.
      "routes": [],
      "workers_dev": true,
      "vars": {
        "MONTHLY_QUOTA_CEILING": "2500",
        "DAILY_QUOTA_CEILING": "90"
      },
      "ratelimits": [
        {
          "name": "EMAIL_RATE_LIMITER",
          "namespace_id": "4",
          "simple": { "limit": 5, "period": 60 }
        }
      ],
      "d1_databases": [
        {
          "binding": "EMAIL_DB",
          "database_name": "ampl-email-staging-db",
          "database_id": "bfdfd768-c85a-41ec-a378-29a97baf872a",
          "migrations_dir": "drizzle-email"
        }
      ]
    }
  }
}
