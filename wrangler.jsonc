// Cloudflare Workers configuration (ampl-auth)
//
// This file tells Wrangler how to build, deploy, and bind the `ampl-auth`
// Worker. It maps the Worker to the `ampl.tools/auth` route, declares the
// production D1 database (`AUTH_DB`) and the per-IP rate limiter, sets the
// public app name and URL, and defines a separate `staging` environment that
// runs at its own workers.dev URL against a staging database. Secrets
// (`GITHUB_CLIENT_ID`, `GITHUB_CLIENT_SECRET`) are set per environment with
// `wrangler secret put`, never stored here.
//
// Version: v0.4.0
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ampl-auth",
  "compatibility_date": "2026-04-15",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./workers/app.ts",
  // Served at ampl.tools/auth (shared AMPL sign-in). The apex needs a proxied
  // DNS record for this route to receive traffic. `workers_dev` is disabled in
  // production so the Worker is reachable only via the route. account_id is
  // resolved from CLOUDFLARE_ACCOUNT_ID.
  "routes": [
    { "pattern": "ampl.tools/auth*", "zone_name": "ampl.tools" }
  ],
  "workers_dev": false,
  // Secrets (per-env via `wrangler secret put`): GITHUB_CLIENT_ID,
  // GITHUB_CLIENT_SECRET, TURNSTILE_SECRET_KEY. See .dev.vars.example. (No
  // SESSION_SECRET — opaque hashed sessions need no signing key; OAuth cookies
  // are validated, not signed.)
  //
  // Email sign-in links: off until EMAIL_LOGIN_ENABLED is "true". Only
  // addresses whose domain is listed in EMAIL_LOGIN_DOMAINS (comma-separated,
  // exact match) may request a link. TURNSTILE_SITE_KEY is public; leave it
  // empty until the Turnstile widget exists, and the request form refuses to
  // send links while it or TURNSTILE_SECRET_KEY is missing.
  "vars": {
    "APP_NAME": "AMPL Auth",
    "APP_URL": "https://ampl.tools/auth",
    "EMAIL_LOGIN_ENABLED": "true",
    "EMAIL_LOGIN_DOMAINS": "ucsb.edu,neogranadina.org",
    "TURNSTILE_SITE_KEY": "0x4AAAAAAF7fU9jO-81HQmkO"
  },
  // Sign-in emails go through the ampl-email Worker's AuthEmail entrypoint,
  // which renders the two fixed sign-in templates; the Resend key stays in
  // that Worker. This Worker does not bind the general send().
  "services": [
    { "binding": "AUTH_EMAIL", "service": "ampl-email", "entrypoint": "AuthEmail" }
  ],
  "ratelimits": [
    {
      "name": "AUTH_RATE_LIMITER",
      "namespace_id": "1",
      "simple": { "limit": 5, "period": 60 }
    }
  ],
  "d1_databases": [
    {
      "binding": "AUTH_DB",
      "database_name": "ampl-auth-db",
      "database_id": "3236f46a-d261-4993-8bad-f8da485acd2a",
      "migrations_dir": "drizzle"
    }
  ],
  "env": {
    "staging": {
      "name": "ampl-auth-staging",
      // Staging is served at staging.ampl.tools, the host all staging tools
      // share, so the host-only session cookie set here reaches them. This
      // Worker holds the custom domain; each tool adds its own path route.
      "routes": [
        { "pattern": "staging.ampl.tools", "custom_domain": true }
      ],
      "workers_dev": true,
      "vars": {
        "APP_NAME": "AMPL Auth [Staging]",
        "APP_URL": "https://staging.ampl.tools/auth",
        "EMAIL_LOGIN_ENABLED": "true",
        "EMAIL_LOGIN_DOMAINS": "ucsb.edu,neogranadina.org",
        // Cloudflare's always-pass test key; staging only.
        "TURNSTILE_SITE_KEY": "1x00000000000000000000AA"
      },
      "services": [
        { "binding": "AUTH_EMAIL", "service": "ampl-email-staging", "entrypoint": "AuthEmail" }
      ],
      "ratelimits": [
        {
          "name": "AUTH_RATE_LIMITER",
          "namespace_id": "2",
          "simple": { "limit": 5, "period": 60 }
        }
      ],
      "d1_databases": [
        {
          "binding": "AUTH_DB",
          "database_name": "ampl-auth-staging-db",
          "database_id": "2cd4ddc2-ed91-4bf9-9a3f-1d8f0f1f502f",
          "migrations_dir": "drizzle"
        }
      ]
    }
  }
}
